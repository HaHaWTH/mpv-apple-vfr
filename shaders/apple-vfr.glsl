// Apple Video Flashing Reduction, PDF v1.0 (March 2023), equations (1)-(19).
// Coefficients: Apple's UFMKernels03.mat, commit 6e9604d92446c8e6763bc53c5e12ccc4e0046796.
// Requires mpv vo=gpu-next (libplacebo STORAGE buffers + compute shaders).

//!PARAM PTS
//!TYPE DYNAMIC float
0.0

//!PARAM enabled
//!TYPE DYNAMIC int
//!MINIMUM 0
//!MAXIMUM 1
1

//!PARAM reset_epoch
//!TYPE DYNAMIC int
0

//!PARAM rate_index
//!TYPE CONSTANT int
//!MINIMUM 0
//!MAXIMUM 6
4

//!PARAM peak_nits
//!TYPE float
//!MINIMUM 0.0001
500.0

//!PARAM area_deg2
//!TYPE float
//!MINIMUM 0.0001
1265.63

//!PARAM y_r
//!TYPE float
0.2126729

//!PARAM y_g
//!TYPE float
0.7151522

//!PARAM y_b
//!TYPE float
0.0721750

//!PARAM comparison
//!TYPE DYNAMIC int
//!MINIMUM 0
//!MAXIMUM 1
0

//!BUFFER VFR_COEFFICIENTS
//!VAR vec4 vfr_coeff[1064]



//!BUFFER VFR_STATE
//!VAR int vfr_initialized
//!VAR int vfr_epoch
//!VAR float vfr_last_pts
//!VAR int vfr_count
//!VAR float vfr_adaptation
//!VAR float vfr_mitigation
//!VAR float vfr_energy
//!VAR float vfr_correlation_energy
//!VAR float vfr_risk
//!VAR float vfr_mean
//!VAR float vfr_slope
//!VAR float vfr_offset
//!VAR float vfr_contrast[32]
//!VAR float vfr_response_squared[640]
//!VAR float vfr_correlation_squared[640]
//!STORAGE


//!HOOK MAIN
//!BIND HOOKED
//!SAVE VFR_SUM_TILES
//!COMPONENTS 4
//!WIDTH 32
//!HEIGHT 32
//!COMPUTE 1 1 16 16
//!WHEN enabled
//!DESC Apple VFR: full-resolution linear luminance reduction

shared float vfr_shared[256];

void hook()
{
    ivec2 size = ivec2(HOOKED_size);
    ivec2 tile = ivec2(gl_WorkGroupID.xy);
    ivec2 grid = ivec2(32);
    ivec2 begin = tile * size / grid;
    ivec2 end = (tile + 1) * size / grid;
    vec3 white = linearize(vec4(1.0)).rgb;
    vec3 weights = vec3(y_r, y_g, y_b);
    float sum = 0.0;
    // Every source pixel contributes exactly once; no spatial subsampling.
    for (int y = begin.y + int(gl_LocalInvocationID.y); y < end.y; y += 16) {
        for (int x = begin.x + int(gl_LocalInvocationID.x); x < end.x; x += 16) {
            vec4 encoded = texelFetch(HOOKED_raw, ivec2(x, y), 0) * HOOKED_mul;
            vec3 normalized = linearize(encoded).rgb / white;
            sum += dot(normalized, weights);
        }
    }
    uint index = gl_LocalInvocationIndex;
    vfr_shared[index] = sum;
    barrier();
    for (uint step = 128u; step > 0u; step >>= 1u) {
        if (index < step)
            vfr_shared[index] += vfr_shared[index + step];
        barrier();
    }
    if (index == 0u) {
        // Encode FP32 into four exact bytes: intermediate FBOs may be FP16.
        uint bits = floatBitsToUint(vfr_shared[0]);
        uvec4 bytes = uvec4(bits, bits >> 8u, bits >> 16u, bits >> 24u) & uvec4(255u);
        imageStore(out_image, tile, vec4(bytes) / 255.0);
    }
}

//!HOOK MAIN
//!BIND HOOKED
//!BIND VFR_SUM_TILES
//!BIND VFR_STATE
//!BIND VFR_COEFFICIENTS
//!SAVE VFR_PARAMETERS
//!COMPONENTS 4
//!WIDTH 8
//!HEIGHT 1
//!COMPUTE 8 1 1 1
//!WHEN enabled
//!DESC Apple VFR: PDF temporal metric, step mask and mitigation

float vfr_coefficient(int index)
{
    return vfr_coeff[index / 4][index % 4];
}

float vfr_unpack(vec4 packed)
{
    uvec4 b = uvec4(round(packed * 255.0));
    return uintBitsToFloat(b.x | (b.y << 8u) | (b.z << 16u) | (b.w << 24u));
}

void vfr_write_factors()
{
    float fields[8] = float[8](vfr_slope, vfr_offset, vfr_mean, vfr_adaptation,
        vfr_energy, vfr_correlation_energy, vfr_risk, vfr_mitigation);
    for (int i = 0; i < 8; ++i) {
        uint bits = floatBitsToUint(fields[i]);
        imageStore(out_image, ivec2(i, 0), vec4(uvec4(bits, bits >> 8u, bits >> 16u, bits >> 24u) & uvec4(255u)) / 255.0);
    }
}

float vfr_interpolate(float luminance, float energy[5])
{
    const float levels[5] = float[5](0.2, 1.0, 10.0, 150.0, 500.0);
    if (luminance <= levels[0])
        return energy[0];
    for (int k = 1; k < 5; ++k) {
        if (luminance < levels[k]) {
            float fraction = log(luminance / levels[k - 1]) / log(levels[k] / levels[k - 1]);
            return mix(energy[k - 1], energy[k], fraction);
        }
    }
    return energy[4];
}

void hook()
{
    // mpv can redraw the same video frame for OSD, pause and screenshots.
    // PTS identifies a sample; these redraws do not advance the temporal model.
    bool first = vfr_initialized == 0 || vfr_epoch != reset_epoch || PTS < vfr_last_pts;
    if (first) {
        vfr_initialized = 1;
        vfr_epoch = reset_epoch;
        vfr_count = 0;
        vfr_mitigation = 0.0;
        for (int j = 0; j < 32; ++j)
            vfr_contrast[j] = 0.0;
        for (int j = 0; j < 640; ++j) {
            vfr_response_squared[j] = 0.0;
            vfr_correlation_squared[j] = 0.0;
        }
    }
    if (!first && PTS == vfr_last_pts) {
        vfr_write_factors();
        return;
    }
    float luminance_sum = 0.0;
    for (int y = 0; y < int(VFR_SUM_TILES_size.y); ++y)
        for (int x = 0; x < int(VFR_SUM_TILES_size.x); ++x)
            luminance_sum += vfr_unpack(texelFetch(VFR_SUM_TILES_raw, ivec2(x, y), 0));
    float luminance = luminance_sum / (HOOKED_size.x * HOOKED_size.y);
    const float rates[7] = float[7](24.0, 25.0, 30.0, 50.0, 60.0, 90.0, 120.0);
    float rate = rates[rate_index];
    float input_size_degrees = sqrt(1.6 * area_deg2); // (2)
    int size_index = abs(input_size_degrees - 6.0) <= abs(input_size_degrees - 20.0) ? 0 : 1;
    float selected_size = size_index == 0 ? 6.0 : 20.0;
    if (abs(input_size_degrees - 45.0) < abs(input_size_degrees - selected_size)) {
        size_index = 2;
        selected_size = 45.0;
    }
    float mu = 1.0 - exp(-1.0 / rate); // (4), tau_L = 1 s
    float adaptation = first ? luminance : vfr_adaptation + mu * (luminance - vfr_adaptation); // (3)
    // All-black input has a=0 and l=0; its contrast and correlations are zero.
    float contrast = adaptation > 0.0 ? (luminance - adaptation) / adaptation : 0.0; // (5)
    int contrast_position = vfr_count % 32;
    int energy_position = vfr_count % 128;
    vfr_contrast[contrast_position] = contrast;
    int gamma_base = 3360 + rate_index * 128;
    int gamma_length = int(vfr_coefficient(gamma_base));
    float energies[5];
    float correlation_energies[5];
    for (int k = 0; k < 5; ++k) {
        int base = ((size_index * 5 + k) * 7 + rate_index) * 32;
        int length = int(vfr_coefficient(base));
        float response = 0.0;
        float correlation = 0.0;
        float contrast_norm_squared = 0.0;
        float kernel_norm_squared = 0.0;
        for (int j = 0; j < length; ++j) {
            float c = vfr_contrast[(contrast_position - j + 32) % 32];
            float h = vfr_coefficient(base + 1 + j);
            response += c * h; // (6), newest sample times h(1)
            correlation += c * vfr_coefficient(base + length - j); // (13), reversed taps
            contrast_norm_squared += c * c; // (12)
            kernel_norm_squared += h * h; // (11)
        }
        float denominator = sqrt(contrast_norm_squared * kernel_norm_squared);
        float normalized_correlation = denominator > 0.0 ? correlation / denominator : 0.0;
        int energy_base = k * 128;
        vfr_response_squared[energy_base + energy_position] = response * response;
        vfr_correlation_squared[energy_base + energy_position] = normalized_correlation * normalized_correlation;
        float e = 0.0;
        float f = 0.0;
        for (int j = 0; j < gamma_length; ++j) {
            int position = energy_base + (energy_position - j + 128) % 128;
            float weight = vfr_coefficient(gamma_base + 1 + j); // (8), samples t=(j+1)/W
            e += vfr_response_squared[position] * weight;
            f += vfr_correlation_squared[position] * weight;
        }
        energies[k] = sqrt(e); // (7), alpha=2
        correlation_energies[k] = sqrt(f); // (14)
    }
    float energy = vfr_interpolate(adaptation * peak_nits, energies);
    energy *= pow(input_size_degrees / selected_size, 2.0 * 0.263) / sqrt(rate); // (9), G=1
    float correlation_energy = vfr_interpolate(adaptation * peak_nits, correlation_energies);
    float risk = energy > 33.0 ? 100.0 * (1.0 - exp(-pow((energy - 33.0) / 200.0, 3.0))) : 0.0; // (10)
    if (correlation_energy < 1.8)
        risk = 0.0; // Step masking, PDF p.11
    float mitigation = 0.5 * log(max(1.0, risk)) / log(10.0); // (16), M=1
    if (mitigation < vfr_mitigation) {
        float mu_m = 1.0 - exp(-1.0 / (2.0 * rate)); // (18), tau_m=2 s
        mitigation = mu_m * mitigation + (1.0 - mu_m) * vfr_mitigation; // (17)
    }
    float contrast_factor = 1.0 - mitigation; // (19), w_C=1
    float luminance_factor = 1.0 - 0.5 * mitigation; // (19), w_L=0.5
    vfr_slope = contrast_factor * luminance_factor;
    vfr_offset = adaptation * (1.0 - contrast_factor) * luminance_factor; // (15)
    vfr_adaptation = adaptation;
    vfr_mitigation = mitigation;
    vfr_energy = energy;
    vfr_correlation_energy = correlation_energy;
    vfr_risk = risk;
    vfr_mean = luminance;
    vfr_last_pts = PTS;
    vfr_count += 1;
    memoryBarrierBuffer();
    vfr_write_factors();
}

//!HOOK MAIN
//!BIND HOOKED
//!BIND VFR_PARAMETERS
//!WHEN enabled
//!DESC Apple VFR: linear-light contrast and luminance transfer

float vfr_unpack(vec4 packed)
{
    uvec4 b = uvec4(round(packed * 255.0));
    return uintBitsToFloat(b.x | (b.y << 8u) | (b.z << 16u) | (b.w << 24u));
}

vec4 hook()
{
    vec4 original = HOOKED_tex(HOOKED_pos);
    if (comparison != 0 && HOOKED_pos.x < 0.5)
        return original;
    vec3 white = linearize(vec4(1.0)).rgb;
    vec4 color = linearize(original);
    float slope = vfr_unpack(texelFetch(VFR_PARAMETERS_raw, ivec2(0, 0), 0));
    float offset = vfr_unpack(texelFetch(VFR_PARAMETERS_raw, ivec2(1, 0), 0));
    color.rgb = (color.rgb / white * slope + vec3(offset)) * white; // (15)
    color = delinearize(color);
    color.a = original.a;
    return color;
}
